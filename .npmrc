# React Native's Metro bundler resolves modules by walking node_modules directories,
# and it does not follow pnpm's strict symlinked layout: a transitive dependency
# that pnpm keeps private (url-parse, required by @expo/metro-runtime) is simply
# invisible to it, and the bundle fails to resolve.
#
# Hoisting makes node_modules look the way Metro expects. This is the documented
# arrangement for Expo inside a pnpm workspace, not a workaround for a local quirk.
node-linker=hoisted
