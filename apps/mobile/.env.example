# Copy to .env and set the address the PHONE can reach.
#
# Not localhost: on a device, localhost is the device. Use the LAN IP of the
# machine running the API, and keep the phone on the same Wi-Fi.
# Find it with: ipconfig  (Windows)  ·  ipconfig getifaddr en0  (macOS)
#
# Android emulator instead of a physical phone? Use http://10.0.2.2:3333/v1 —
# that is the emulator's fixed alias for the host machine.
EXPO_PUBLIC_API_URL=http://192.168.1.20:3333/v1
