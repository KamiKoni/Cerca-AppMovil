{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "isolatedModules": true,
    "paths": {
      "@contract/*": [
        "../../packages/contract/src/*"
      ],
      "@cerca/contract": [
        "../../packages/contract/src/index.ts"
      ],
      "@cerca/contract/*": [
        "../../packages/contract/src/*"
      ]
    }
  },
  "include": [
    "app/**/*",
    "src/**/*",
    "app.config.ts"
  ]
}
