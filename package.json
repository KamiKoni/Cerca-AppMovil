{
  "name": "cerca-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "verify": "bash ./scripts/verify.sh",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "eslint-plugin-import": "^2.31.1",
    "prettier": "^3.0.0",
    "typescript": "^5.5.0",
    "vitest": "^1.0.0",
    "zod": "^3.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.20.0",
      "onFail": "download"
    }
  },
  "type": "module"
}
